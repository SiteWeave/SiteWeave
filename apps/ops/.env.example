# Localhost ops dashboard — DO NOT DEPLOY
# Copy to .env.local and fill in values. Service role key never ships to Siteweave clients.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: deep-link to Sentry issues
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
