{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "22.14.0"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "22.14.0"
    },
    "production": {
      "channel": "production",
      "node": "22.14.0",
      "autoIncrement": true,
      "env": {
        "YARN_IGNORE_ENGINES": "1",
        "SENTRY_ALLOW_FAILURE": "true",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "apk": {
      "channel": "preview",
      "node": "22.14.0",
      "env": {
        "YARN_IGNORE_ENGINES": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6756014286"
      }
    }
  }
}
